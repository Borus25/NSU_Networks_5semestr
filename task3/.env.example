# Скопируйте этот файл в .env и заполните значения.
# Настоящие ключи и контактные данные не добавляйте в публичный репозиторий.

# Обязательный ключ GraphHopper Geocoding.
GRAPHHOPPER_API_KEY=

# Обязательный ключ OpenWeather Current Weather.
OPENWEATHER_API_KEY=

# Обязательный User-Agent для Wikimedia.
# Замените заполнитель на свой настоящий контакт.
WIKIPEDIA_USER_AGENT="PlacesLab/0.1 (mailto:YOUR_REAL_EMAIL)"

# Необязательные endpoint: эти значения уже заданы по умолчанию в коде.
# Не добавляйте сюда API-ключи, ?q=, ?appid= или другие query-параметры.
GRAPHHOPPER_GEOCODING_URL=https://graphhopper.com/api/1/geocode
OPENWEATHER_WEATHER_URL=https://api.openweathermap.org/data/2.5/weather
WIKIPEDIA_API_URL=https://ru.wikipedia.org/w/api.php

# Сохранено для совместимости с текущим конфигом.
# Основной поиск локаций выполняет GraphHopper, не OpenWeather Geocoding.
OPENWEATHER_GEOCODING_URL=https://api.openweathermap.org/geo/1.0/direct

# HTTPTimeout, OperationTimeout и DetailsWorkers сейчас задаются в коде.
# Переменные окружения для них в текущем config.Load() не реализованы.
